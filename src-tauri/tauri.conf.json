{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LUMI RETOUCH",
  "version": "0.1.0",
  "identifier": "com.lumi.retouch",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LUMI RETOUCH",
        "width": 1440,
        "height": 900,
        "minWidth": 1180,
        "minHeight": 720,
        "resizable": true,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": true,
        "backgroundColor": "#0b0c0e"
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri: http://tauri.localhost; script-src 'self' tauri: http://tauri.localhost; style-src 'self' 'unsafe-inline' tauri:; img-src 'self' data: blob: tauri:; font-src 'self' data: tauri:; connect-src 'self' ipc: http://ipc.localhost tauri:; media-src 'self' data: blob: tauri:; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis"
    ],
    "category": "Photography",
    "shortDescription": "专业 AI 人像修图工作台",
    "longDescription": "LUMI RETOUCH 是一款面向专业摄影后期的 AI 人像修图桌面应用，提供统一参数管线、无损对比与本地高速图像处理。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/models/yunet/face_detection_yunet_2023mar.onnx",
      "resources/models/yunet/LICENSE"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "languages": [
          "SimpChinese",
          "English"
        ]
      }
    }
  }
}